HOMESERVER_URL='http://127.0.0.1:6167'
REGISTRATION_SHARED_SECRET='look in your tuwunels homeserver.yaml'
AS_TOKEN='look in the app-service.yaml'
EXCLUDED_USERS='rocket.cat' # Comma-separated list of usernames or IDs
ADMIN_USERNAME='admin' # The login name of the Rocket.Chat admin/new Matrix admin
ADMIN_PASSWORD='verySecretPassword' # The password of the Rocket.Chat admin/new Matrix admin

# End-to-end encryption (needs Node.js >= 24 and @matrix-org/matrix-sdk-crypto-nodejs)
E2EE=false # true: encrypted rooms, history encrypted by its authors, one recovery key per user
#E2EE_RECOVERY_KEYS_FILE='./recovery-keys.txt' # Personal recovery keys to hand out, then delete
#E2EE_STORE_DIR='./e2ee-store' # Keys of the temporary migration devices, deleted at the end
#E2EE_STORE_PASSPHRASE='' # Encrypts e2ee-store at rest; if empty, generated in e2ee-store.passphrase (deleted at the end)
#E2EE_FINALIZE=true # Log out the migration devices and delete e2ee-store once the check passed
#E2EE_ALLOW_SKIPPED_USERS=false # Finalize even if some users already had their own encryption setup (they get no history keys)
#E2EE_ROTATION_MESSAGES=1000 # Messages per Megolm session of the migrated history
